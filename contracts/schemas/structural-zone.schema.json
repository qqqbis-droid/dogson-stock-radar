{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuralZone",
  "type": "object",
  "required": ["schema_version","build_id","dataset","trade_date","session_phase","as_of","known_at","generated_at","freshness","complete","source_status","zone_id","side","low","high","center","strength","confidence","evidence","created_at","role_state"],
  "properties": {
    "schema_version": {"const":"2.0.0"},
    "build_id": {"type":"string"},
    "dataset": {"const":"zone"},
    "trade_date": {"type":["string","null"],"format":"date"},
    "session_phase": {"enum":["PRE_OPEN","LIVE","CLOSE_FREEZE","POST_CLOSE","NEXT_DAY"]},
    "as_of": {"type":["string","null"],"format":"date-time"},
    "known_at": {"type":["string","null"],"format":"date-time"},
    "generated_at": {"type":"string","format":"date-time"},
    "freshness": {"enum":["LIVE","FRESH","FROZEN","STALE","UNKNOWN"]},
    "complete": {"type":"boolean"},
    "source_status": {
      "type":"object",
      "required":["sources","fallback"],
      "properties": {
        "sources":{"type":"array","items":{"type":"string"}},
        "fallback":{"type":"boolean"},
        "fallback_source":{"type":["string","null"]},
        "fallback_build_id":{"type":["string","null"]},
        "fallback_reason":{"type":["string","null"]},
        "last_success_at":{"type":["string","null"],"format":"date-time"}
      },
      "additionalProperties": false
    },
    "zone_id": {"type":"string"},
    "side": {"enum":["SUPPORT","RESISTANCE"]},
    "rank": {"enum":["S1","S2","R1","R2"]},
    "label": {"type":"string","minLength":1},
    "low": {"type":"number"},
    "high": {"type":"number"},
    "center": {"type":"number"},
    "distance_pct": {"type":["number","null"]},
    "strength": {"type":["number","null"],"minimum":0,"maximum":5},
    "confidence": {"type":["number","null"],"minimum":0,"maximum":100},
    "evidence": {"type":"array","items":{"type":"string"}},
    "evidence_count": {"type":["integer","null"],"minimum":0},
    "evidence_family_count": {"type":["integer","null"],"minimum":0},
    "evidence_families": {"type":"array","items":{"type":"string"}},
    "reliability_label": {"type":["string","null"]},
    "engine_version": {"type":"string","minLength":1},
    "structure_state": {"enum":["TESTING","NEAR","ACTIVE","BROKEN"]},
    "validation_condition": {"type":["string","null"]},
    "invalidation_condition": {"type":["string","null"]},
    "created_at": {"type":"string","format":"date-time"},
    "last_tested_at": {"type":["string","null"],"format":"date-time"},
    "role_state": {"enum":["ORIGINAL","FLIPPED","BROKEN","EXPIRED"]}
  },
  "additionalProperties": false
}
