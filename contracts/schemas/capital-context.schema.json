{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MissionCapitalContext",
  "type":"object",
  "required":["schema_version","build_id","dataset","context","trade_date","session_phase","as_of","known_at","generated_at","freshness","complete","source_status","method","rows"],
  "properties":{
    "schema_version":{"const":"2.0.0"},
    "build_id":{"type":"string","minLength":1},
    "dataset":{"const":"capital_context"},
    "context":{"enum":["INTRADAY","CLOSE"]},
    "trade_date":{"type":["string","null"],"format":"date"},
    "session_phase":{"enum":["PRE_OPEN","LIVE","CLOSE_FREEZE","POST_CLOSE","NEXT_DAY"]},
    "as_of":{"type":["string","null"],"format":"date-time"},
    "known_at":{"type":["string","null"],"format":"date-time"},
    "generated_at":{"type":"string","format":"date-time"},
    "freshness":{"enum":["LIVE","FRESH","FROZEN","STALE","UNKNOWN"]},
    "complete":{"type":"boolean"},
    "source_status":{"type":"object"},
    "method":{"type":"string","minLength":1},
    "rows":{"type":"array","items":{"type":"object","required":["primary_group"],"properties":{
      "primary_group":{"type":"string","minLength":1},
      "member_count":{"type":"integer","minimum":0},
      "heat":{"type":["number","null"],"minimum":-10,"maximum":10},
      "state":{"type":["string","null"]},
      "change_pct":{"type":["number","null"]},
      "turnover_share_pct":{"type":["number","null"]},
      "recent_share_pct":{"type":["number","null"]},
      "previous_share_pct":{"type":["number","null"]},
      "share_change_pp":{"type":["number","null"]},
      "up_pct":{"type":["number","null"],"minimum":0,"maximum":100},
      "above_vwap_pct":{"type":["number","null"],"minimum":0,"maximum":100},
      "pace":{"type":["number","null"]},
      "window_min":{"type":["number","null"]},
      "leaders":{"type":"array"},
      "today_amount_100m":{"type":["number","null"]},
      "net5_amount_100m":{"type":["number","null"]},
      "net20_amount_100m":{"type":["number","null"]},
      "amount_history_days":{"type":"integer","minimum":0},
      "amount_coverage_pct":{"type":["number","null"],"minimum":0,"maximum":100},
      "amount_method":{"type":["string","null"]},
      "today_lots":{"type":["number","null"]},
      "net5_lots":{"type":["number","null"]},
      "net20_lots":{"type":["number","null"]},
      "history_days":{"type":"integer","minimum":0},
      "latest_date":{"type":["string","null"]},
      "flow_streak":{"type":"integer","minimum":0},
      "flow_direction":{"type":["string","null"]},
      "accelerating":{"type":"boolean"},
      "flow_text":{"type":["string","null"]},
      "action":{"type":["string","null"]},
      "ret5_pct":{"type":["number","null"]}
    },"additionalProperties":false}}
  },
  "additionalProperties":false
}
