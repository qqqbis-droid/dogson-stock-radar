{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sector Registry",
  "type": "object",
  "required": ["taxonomy_version","last_reviewed_at","review_due_at","groups","stock_overrides","theme_tags"],
  "properties": {
    "taxonomy_version": {"type":"string","minLength":1},
    "last_reviewed_at": {"type":["string","null"],"format":"date"},
    "review_due_at": {"type":["string","null"],"format":"date"},
    "groups": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["group","confidence","evidence_quality","evidence_urls_or_refs","classification_reason","members"],
        "properties": {
          "group":{"type":"string","minLength":1},
          "confidence":{"type":"number","minimum":0,"maximum":100},
          "evidence_quality":{"enum":["OFFICIAL_DIRECT","OFFICIAL_INDIRECT","CURATED_SEED","NONE"]},
          "evidence_urls_or_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "classification_reason":{"type":["string","null"]},
          "last_reviewed_at":{"type":["string","null"],"format":"date"},
          "review_due_at":{"type":["string","null"],"format":"date"},
          "revenue_evidence_period":{"type":["string","null"]},
          "exposure_pct":{"type":["number","null"],"minimum":0,"maximum":100},
          "members":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9A-Z-]{2,12}$"}}
        },
        "additionalProperties":false
      }
    },
    "stock_overrides": {
      "type":"object",
      "additionalProperties": {
        "type":"object",
        "properties": {
          "primary_group":{"type":["string","null"]},
          "primary_group_confidence":{"type":["number","null"],"minimum":0,"maximum":100},
          "secondary_groups":{"type":"array","items":{"type":"object","required":["group","confidence","exposure_note"],"properties":{"group":{"type":"string","minLength":1},"confidence":{"type":"number","minimum":0,"maximum":100},"exposure_note":{"type":["string","null"]}},"additionalProperties":false}},
          "supply_chain_role":{"type":"array","items":{"type":"string"}},
          "evidence_quality":{"enum":["OFFICIAL_DIRECT","OFFICIAL_INDIRECT","CURATED_SEED","MULTI_BUSINESS_REVIEW","NONE"]},
          "evidence_urls_or_refs":{"type":"array","items":{"type":"string","minLength":1}},
          "classification_reason":{"type":["string","null"]},
          "last_reviewed_at":{"type":["string","null"],"format":"date"},
          "review_due_at":{"type":["string","null"],"format":"date"},
          "revenue_evidence_period":{"type":["string","null"]},
          "exposure_pct":{"type":["number","null"],"minimum":0,"maximum":100}
        },
        "additionalProperties":false
      }
    },
    "theme_tags":{"type":"object","additionalProperties":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}
  },
  "additionalProperties":false
}
